# Huli Automations Hub - Mission Control
# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment: development or production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Application logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost)
HOST=0.0.0.0

# Server port
PORT=8000

# ============================================================================
# SCHEDULER CONFIGURATION
# ============================================================================

# Enable/disable the scheduler (true/false)
SCHEDULER_ENABLED=true

# Path to jobs configuration file (JSON)
JOBS_CONFIG_PATH=./backend/config/jobs_config.json

# Default timeout for job execution (in seconds)
DEFAULT_JOB_TIMEOUT=300

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Directory where job execution logs will be stored
LOGS_DIR=./logs

# ============================================================================
# HOTMART CREDENTIALS
# ============================================================================

# Hotmart API Client ID
HOTMART_CLIENT_ID=your_hotmart_client_id_here

# Hotmart API Client Secret
HOTMART_CLIENT_SECRET=your_hotmart_client_secret_here

# Hotmart Basic Authentication Token (base64 encoded)
HOTMART_BASIC_TOKEN=your_hotmart_basic_token_here

# ============================================================================
# FACEBOOK ADS CREDENTIALS
# ============================================================================

# Facebook Ads API Access Token
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

# Google Sheet ID where Facebook Ads data will be stored
FACEBOOK_SHEET_ID=your_google_sheet_id_here

# ============================================================================
# GOOGLE CREDENTIALS
# ============================================================================

# Path to Google Service Account credentials JSON file
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json

# ============================================================================
# NOTES
# ============================================================================
#
# 1. SECURITY WARNING: Never commit .env file to git
#    This file is already in .gitignore
#
# 2. Get credentials from:
#    - Hotmart: https://www.hotmart.com/api/
#    - Facebook: https://developers.facebook.com/
#    - Google: https://console.cloud.google.com/
#
# 3. Timezone is hardcoded to America/Sao_Paulo in config.py
#
# 4. All timestamps will use the configured timezone
#
